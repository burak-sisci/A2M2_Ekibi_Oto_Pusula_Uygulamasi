# MongoDB (Atlas veya local)
CONNECTION_STRING=mongodb+srv://kullanici:sifre@cluster.mongodb.net/veritabani?retryWrites=true&w=majority
DATABASE_NAME=otopusuladb

# JWT
JWT_SECRET=en-az-32-karakter-gizli-anahtar
ISSUER=OtoPusula
AUDIENCE=OtoPusula
EXPIRYMINUTES=60

# Redis
# Docker içinde: redis:6379,abortConnect=False
# Bulut: host:port,password=...,ssl=True,abortConnect=False
REDIS_CONNECTION_STRING=redis:6379,abortConnect=False

# RabbitMQ
# Docker içinde: amqp://guest:guest@rabbitmq:5672/
# Bulut (CloudAMQP vb.): amqp://user:pass@host/vhost
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@rabbitmq:5672/

# FastAPI ML servisi
FASTAPI_BASE_URL=http://ai-service:8000

# API port
PORT=8080
